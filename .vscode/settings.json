{
  // SystemVerilog LSP：只使用 slang-server。
  // 安装：code --install-extension Hudson-River-Trading.vscode-slang
  // 配置：.slang/server.json + .slang/slang.f
  //
  // 如果 slang-server 不在 PATH 中，改成它的绝对路径。
  "slang.path": "slang-server",

  // 文件类型关联；slang 扩展通过 systemverilog 语言接管 .sv/.svh。
  "files.associations": {
    "*.sv": "systemverilog",
    "*.svh": "systemverilog"
  },

  // slang 扩展支持外部格式化器：把文件内容从 stdin 交给 verible。
  "slang.formatters": [
    {
      "command": "verible-verilog-format --indentation_spaces=4 -",
      "dirs": ["rtl"],
      "languageIds": ["systemverilog"]
    }
  ],

  // 不自动保存格式化，避免大面积 diff；手动 Shift+Alt+F。
  "[systemverilog]": {
    "editor.defaultFormatter": "hudson-river-trading.vscode-slang",
    "editor.formatOnSave": false
  },
  "[verilog]": {
    "editor.defaultFormatter": "hudson-river-trading.vscode-slang",
    "editor.formatOnSave": false
  }
}
