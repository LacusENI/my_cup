// demo.hex —— my_cup RV32I 示例程序
//   addi x1, x0, 8       -> 00800093
//   addi x2, x0, 5       -> 00500113
//   add  x3, x1, x2      -> 002081B3   (x3 = 13)
//   sw   x3, 0(x0)       -> 00302023   (data[0] = 13)
//   lw   x4, 0(x0)       -> 00002203   (x4 = 13)
//   beq  x4, x3, 8       -> 00320463   (相等，跳过下一条)
//   addi x5, x0, 99      -> 06300293   (应被跳过)
//   jal  x0, 0           -> 0000006F   (自循环)
00800093
00500113
002081B3
00302023
00002203
00320463
06300293
0000006F
